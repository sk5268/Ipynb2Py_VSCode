{
  "name": "ipynb2py",
  "displayName": "Jupyter to Python Exporter",
  "description": "Export Jupyter notebooks to Python files",
  "publisher": "sk5268",
  "version": "0.0.1",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.79.0"
  },
  "categories": [
    "Other",
    "Notebooks",
    "Data Science",
    "AI",
    "Formatters",
    "Machine Learning",
    "Snippets"
  ],
  "activationEvents": [
    "onNotebook:jupyter-notebook"
  ],
  "main": "./out/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/sk5268/Ipynb2Py_VSCode.git"
  },
  "contributes": {
    "commands": [
      {
        "command": "ipynb2py.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "ipynb2py.exportToPython",
        "title": "Export to Python",
        "icon": "$(export)"
      }
    ],
    "notebookRenderer": [
      {
        "id": "ipynb2py-renderer",
        "displayName": "Jupyter to Python Exporter",
        "entrypoint": "./out/renderer.js",
        "mimeTypes": [
          "application/x-ipynb+json",
          "application/vnd.jupyter.cells"
        ]
      }
    ],
    "menus": {
      "notebook/toolbar": [
        {
          "command": "ipynb2py.exportToPython",
          "when": "notebookType == 'jupyter-notebook'",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "ipynb2py.exportToPython",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e",
        "when": "notebookEditorFocused && notebookType == 'jupyter-notebook'"
      }
    ],
    "configuration": {
      "title": "Jupyter to Python Exporter",
      "properties": {
        "ipynb2py.confirmOverwrite": {
          "type": "boolean",
          "default": true,
          "description": "Ask for confirmation before overwriting existing Python files"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.79.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "eslint": "^9.23.0",
    "typescript": "^5.8.2",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1"
  }
}
